{
  "id": "110E4F8061866777",
  "filename": "start",
  "title": "1. Жизнь под землёй",
  "icon": "minecraft:stone_pickaxe",
  "group": "78E2EFAD05ED3E05",
  "order_index": 0,
  "default_hide_dependency_lines": false,
