<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(LauncherBin)/*.dll" />
  </ItemGroup>
  <Target Name="CheckLauncherBin" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(LauncherBin)/LANMinecraft.dll')" Text="Pass -p:LauncherBin pointing to a built LANMinecraft directory." />
  </Target>
</Project>
